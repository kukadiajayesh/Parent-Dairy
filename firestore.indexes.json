{
  "indexes": [
    {
      "//": "Timeline: the active year's records, newest first.",
      "collectionGroup": "records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "academicYearId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Search scoped to one academic year (§15).",
      "collectionGroup": "records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "searchTerms", "arrayConfig": "CONTAINS" },
        { "fieldPath": "academicYearId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Search across every year (§15's 'all years' option).",
      "collectionGroup": "records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "searchTerms", "arrayConfig": "CONTAINS" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Upload queue: records whose files never reached Storage.",
      "collectionGroup": "records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "hasPendingUpload", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Performance tab: the active year's exam results, newest first.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "academicYearId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "All-years trend: every result for a child, newest first.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Marks group in search, scoped to one year.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "searchTerms", "arrayConfig": "CONTAINS" },
        { "fieldPath": "academicYearId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Marks group in search, all years.",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "searchTerms", "arrayConfig": "CONTAINS" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Child list, oldest first, excluding soft-deleted profiles.",
      "collectionGroup": "children",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isDeleted", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Active subjects in display order.",
      "collectionGroup": "subjects",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
