rules_version = '2';

// Parent Academic Diary — Cloud Storage security rules (§29, §33).
//
// Files mirror the Firestore layout: everything a parent uploads lives under
// `users/{uid}/…`, and nothing is ever world-readable. The path itself carries
// the ownership check, so there is no shared or public prefix to get wrong.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Matches §31/§32's client-side limit, enforced again server-side so a
    // modified client cannot fill the bucket.
    function isAcceptableUpload() {
      return request.resource.size <= 25 * 1024 * 1024
             && (
               request.resource.contentType.matches('image/(jpeg|jpg|png)')
               || request.resource.contentType == 'application/pdf'
             );
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isAcceptableUpload();
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
